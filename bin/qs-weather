#!/usr/bin/env bash
# qs-weather [refresh|set NAME|clear|status]
# Fetches current conditions + today's/tomorrow's sunrise/sunset from open-meteo
# into ~/.local/state/qs/weather.json (Quickshell watches it). Location: ~/.local/state/qs/weather-location.json
# {name,latitude,longitude}; without it, IP geolocation (wttr.in) is used.
set -Eeuo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

state="${XDG_STATE_HOME:-$HOME/.local/state}/qs"
loc_file="$state/weather-location.json"
auto_file="$state/weather-location.auto.json" # last IP-derived location; survives offline wakes
out="$state/weather.json"
mkdir -p "$state"
rm -f "$out".?????? # tmp files orphaned by a kill mid-fetch
tmp=""
trap '[[ -n "$tmp" ]] && rm -f "$tmp"' EXIT # failed fetch must not leave a partial file

fetch() { curl -fsSL --max-time 10 --retry 2 "$@"; }

geocode() { # NAME → {name,latitude,longitude} or empty
	fetch "https://geocoding-api.open-meteo.com/v1/search?name=$(jq -rn --arg q "$1" '$q|@uri')&count=1&language=en" |
		jq -c '.results[0] // empty | {name: ([.name, .admin1, .country_code] | map(select(. != null)) | join(", ")), latitude, longitude}'
}

# Pinned location wins; otherwise IP geolocation, cached so a network blip
# (typical right after resume) does not drop the location.
location() {
	if [[ -s "$loc_file" ]]; then
		cat "$loc_file"
		return
	fi
	local city loc
	city="$(fetch 'https://wttr.in/?format=%l' || true)"
	loc="$([[ -n "$city" ]] && geocode "$city" || true)"
	if [[ -n "$loc" ]]; then
		printf '%s\n' "$loc" >"$auto_file"
	elif [[ -s "$auto_file" ]]; then
		loc="$(cat "$auto_file")"
	fi
	printf '%s' "$loc"
}

# Keeps the previous weather.json on any failure so the widget shows stale
# data instead of vanishing; writes an error marker only when nothing exists.
refresh() {
	local loc lat lon name
	loc="$(location)" || true
	[[ -n "$loc" ]] || {
		[[ -s "$out" ]] || jq -cn '{error: "no location"}' >"$out"
		return 1
	}
	lat="$(jq -r .latitude <<<"$loc")"
	lon="$(jq -r .longitude <<<"$loc")"
	name="$(jq -r .name <<<"$loc")"
	tmp="$(mktemp "$out.XXXXXX")"
	fetch "https://api.open-meteo.com/v1/forecast?latitude=$lat&longitude=$lon&current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,weather_code,is_day&daily=sunrise,sunset&forecast_days=2&timezone=auto" |
		jq -c --arg name "$name" '{name: $name, updated: now, current, daily}' >"$tmp"
	mv "$tmp" "$out"
	tmp=""
}

case "${1:-refresh}" in
refresh) refresh ;;
set)
	[[ -n "${2:-}" ]] || {
		echo "usage: qs-weather set NAME" >&2
		exit 2
	}
	loc="$(geocode "$2")"
	[[ -n "$loc" ]] || {
		"$here"/qs-notify -u low "Weather" "No match for '$2'"
		exit 1
	}
	printf '%s\n' "$loc" >"$loc_file"
	refresh
	;;
clear)
	rm -f "$loc_file"
	refresh
	;;
status)
	[[ -s "$out" ]] && jq -e .current "$out" >/dev/null 2>&1 || {
		echo "no weather data" >&2
		exit 1
	}
	jq -r '"\(.name): \(.current.temperature_2m)° · feels \(.current.apparent_temperature)° · wind \(.current.wind_speed_10m) km/h · \(.current.relative_humidity_2m)% humidity"' "$out"
	;;
*)
	echo "usage: qs-weather [refresh|set NAME|clear|status]" >&2
	exit 2
	;;
esac
