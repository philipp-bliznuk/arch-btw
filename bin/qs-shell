#!/usr/bin/env bash
# qs-shell [-q] <target> <function> [args...]
# Thin wrapper over `qs ipc call`. -q swallows output and errors (fire-and-forget).
set -Eeuo pipefail

quiet=0
if [[ "${1:-}" == "-q" ]]; then
	quiet=1
	shift
fi
[[ $# -ge 2 ]] || {
	echo "usage: qs-shell [-q] <target> <function> [args...]" >&2
	exit 2
}

if ((quiet)); then
	timeout 3 qs ipc call "$@" >/dev/null 2>&1 || true
else
	timeout 3 qs ipc call "$@"
fi
