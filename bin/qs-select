#!/usr/bin/env bash
# qs-select <prompt> [option...]   (or options on stdin, one per line)
# Option format: "label[<TAB>subtext[<TAB>glyph]]". Prints chosen label; exit 1 if cancelled.
set -Eeuo pipefail

prompt="${1:?usage: qs-select <prompt> [option...]}"
shift
if (($#)); then
	tsv="$(printf '%s\n' "$@")"
else
	tsv="$(cat)"
fi

out="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/qs-select.XXXXXX")"
rm -f "$out"
trap 'rm -f "$out"' EXIT

qs ipc call launcher select "$prompt" "$tsv" "$out"

# wait for the launcher to write (choice) or touch (cancel) the file
for _ in $(seq 1 600); do
	[[ -e "$out" ]] && break
	sleep 0.1
done
[[ -s "$out" ]] || exit 1
cat "$out"
echo
