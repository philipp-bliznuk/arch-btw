#!/usr/bin/env bash
# qs-wifi-prefer <ssid> - make <ssid> the preferred Wi-Fi network: its profile
# gets autoconnect-priority 10, every other Wi-Fi profile 0. Called when the
# user deliberately picks a network in the Quickshell popup, so after a reboot
# or AP outage NetworkManager returns to the network that was chosen on purpose
# rather than whichever one answered first. No roaming: NM never leaves an
# active connection for a higher priority one, and that is intended.
set -Eeuo pipefail

(( $# == 1 )) || { sed -n '2p' "$0" >&2; exit 64; }
want="$1"

# Profiles by UUID: terse nmcli escapes : and \ in names, and a name may hold
# either. The SSID is read unescaped (-e no) to compare with the raw one given.
while IFS=: read -r uuid type; do
	[[ "$type" == "802-11-wireless" ]] || continue
	ssid="$(nmcli -e no -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null || true)"
	prio=0
	[[ "$ssid" == "$want" ]] && prio=10
	# one profile refusing (not ours to edit) must not leave the rest unranked
	nmcli connection modify "$uuid" connection.autoconnect-priority "$prio" \
		|| echo "qs-wifi-prefer: $uuid: priority not set" >&2
done < <(nmcli -t -f UUID,TYPE connection show)
