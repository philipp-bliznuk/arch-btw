#!/usr/bin/env bash
# qs-apps list        -> JSON array of .desktop ids the launcher may show
# qs-apps hide <id>   -> append <id> to the blacklist, then print the list
#
# Allowed = explicitly installed pacman packages (pacman -Qe), user-local
# ~/.local/share/applications, flatpak exports; minus ids listed in
# ~/.config/quickshell/apps-hide (one per line, # comments). Dependencies
# like avahi or hwloc ship .desktop files nobody asked for; this keeps them out.
set -Eeuo pipefail

hide_file="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/apps-hide"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"

ids_from_files() {
	sed -nE 's#.*/applications/([^/]+)\.desktop$#\1#p'
}

allowed() {
	{
		pacman -Qql $(pacman -Qqe) 2>/dev/null | ids_from_files
		for d in "$data_home/applications" "$data_home/flatpak/exports/share/applications" /var/lib/flatpak/exports/share/applications; do
			[[ -d "$d" ]] && find "$d" -maxdepth 1 -name '*.desktop' 2>/dev/null | ids_from_files
		done
	} | sort -u
}

hidden() {
	[[ -f "$hide_file" ]] || return 0
	sed -E 's/#.*//; s/^[[:space:]]+//; s/[[:space:]]+$//' "$hide_file" | grep -v '^$' | sort -u
}

list() {
	comm -23 <(allowed) <(hidden) | jq -R . | jq -sc .
}

hide() {
	local id="${1:?usage: qs-apps hide <id>}"
	mkdir -p "$(dirname "$hide_file")"
	if ! hidden | grep -qxF "$id"; then
		printf '%s\n' "$id" >>"$hide_file"
	fi
	list
}

case "${1:-list}" in
list) list ;;
hide) hide "${2:-}" ;;
*)
	echo "usage: qs-apps list | hide <id>" >&2
	exit 2
	;;
esac
