# Dirs
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."

# Eza (tiered)
alias ls="eza --color=always --icons=always"
alias ll="eza --color=always --long --git --icons=always"
alias la="eza --color=always --long --git --all --icons=always"
alias lt="eza --color=always --tree --level=2 --icons=always"

# Convenience
alias n="nvim"
alias dotf='cd "$HOME/projects/dotfiles/" && ${VISUAL:-${EDITOR:-nvim}}'

# Safety: ask before overwriting; rm asks once for more than three files or
# a recursive delete (-I, not -i: a prompt per file trains a reflexive y).
# Interactive shells only; scripts and `command rm` are unaffected.
alias cp="cp -i"
alias mv="mv -i"
alias rm="rm -I"

# Yubikey resync
alias yksync='gpg-connect-agent "scd serialno" "learn --force" /bye'
