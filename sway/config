# Sway config — scaffold. See README.md Step 8 #11.
# Starts from the stock /etc/sway/config; the notes below capture the edits
# this setup relies on. Flesh out bindings/appearance later.

### Variables
set $mod Mod4
set $term ghostty
# Quickshell owns the launcher; exact IPC verb depends on your shell config.
set $menu qs ipc call launcher toggle

### Input
input * {
    xkb_layout us
}

### Output
# No `output * bg ...` line — swaybg is not installed. Quickshell paints the
# wallpaper. A stock `output * bg` line would fail with swaybg missing.

### Autostart
# One Quickshell instance drives bar + launcher + notifications + wallpaper.
exec quickshell

# Idle + lock ladder (swayidle/swaylock are the boring, security-critical path;
# they are intentionally NOT part of Quickshell).
exec swayidle -w \
    timeout 900 'pgrep -x swaylock || swaylock -f' \
    timeout 905 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    timeout 1800 'systemctl suspend-then-hibernate' \
    before-sleep 'pgrep -x swaylock || swaylock -f'

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu

# Volume / mic (wpctl, not pactl); --limit keeps 100% a hard ceiling.
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Screenshot region to ~/Pictures
bindsym Print exec grim -g "$(slurp)" "$HOME/Pictures/$(date +'%Y-%m-%d_%H-%M-%S').png"

### Do NOT add a `bar {}` block.
# Quickshell draws its own layer-shell bar. A stock bar block would spawn
# swaybar alongside it.

# Keep the systemd/portal drop-ins (50-systemd-user.conf wires up portals).
include /etc/sway/config.d/*
