### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $menu qs-shell launcher toggle

### Input
input type:keyboard {
    xkb_layout us,ua,ru
    # caps:super - Caps Lock is a second $mod for one-handed workspace keys
    xkb_options grp:alt_shift_toggle,caps:super
    repeat_delay 200
    repeat_rate 35
}

input type:touchpad {
    tap enabled
    # two-finger click = right, three = middle; libinput's default splits the pad into button areas
    click_method clickfinger
    scroll_factor 0.4
}

# What sway synthesizes itself when no seat is named, stated so a reload
# applies it once. Without the line load_main_config stores a fallback seat
# config and applies it, then applies every stored seat config again: every
# keyboard gets its keymap compiled, serialised and set ten times instead of
# five (README, Reload).
seat seat0 fallback true

### Output
# No `output * bg` - swaybg not installed; Quickshell paints the wallpaper.
# Laptop panel is primary (workspaces 1 and 4); externals sit to its right.
output eDP-1 position 0 0
output HDMI-A-2 position 1366 0

### Autostart
# qs-session: import env into systemd --user, start quickshell, wait for IPC, re-apply toggles
exec qs-session start

# Idle ladder (screensaver / lock / blank / suspend) and the lock screen live
# in Quickshell (lock/); the lid is logind's (post-install step lid). swayidle
# only bridges logind: lock on its Lock signal (loginctl lock-session), lock
# before sleep with the players paused, the touch path held back and the
# outputs off (qs-lock --sleep, swaylock fallback), and after resume relight,
# refresh clock-bound state and start the touch path on the rescanned token.
exec swayidle -w \
    lock 'qs-lock' \
    before-sleep 'qs-lock --sleep' \
    after-resume 'swaymsg -q "output * power on"; qs-shell -q shell resume'

# Lid: logind owns the switch (step lid), sway only folds the panel away.
# Shut: eDP-1 off, its workspaces move to the external display (clamshell);
# open: back, and the assignments below bring 1 and 4 home. Undocked the
# panel is off for the second before sleep and back on wake. --reload
# re-applies the state on a config reload, --locked works at the lock screen.
bindswitch --reload --locked lid:on output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable

### Basics
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Ctrl+q exec qs-quit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym $mod+Shift+r exec qs-session restart
# --locked: also re-locks a red screen left by a dead lock client
bindsym --locked $mod+Escape exec qs-lock
bindsym $mod+Shift+n exec qs-toggle dnd
bindsym $mod+Shift+d exec qs-shell -q notifications dismissLatest
bindsym $mod+Shift+a exec qs-shell -q notifications actionLatest
bindsym $mod+n exec qs-shell launcher open notifications
bindsym $mod+c exec qs-shell launcher open clipboard
bindsym $mod+Shift+t exec qs-toggle nightlight
bindsym $mod+Shift+i exec qs-toggle awake
bindsym $mod+Shift+w exec qs-wallpaper random
bindsym $mod+Shift+Return exec NO_TMUX=1 kitty --class qs-float
floating_modifier $mod

### Focus / move
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

### Workspaces
# 1, 4 → laptop; 2, 3 → first external when present (fall back to laptop).
# Sway moves them back out when a higher-priority output is plugged in.
workspace 1 output eDP-1
workspace 2 output HDMI-A-2 HDMI-A-1 DP-1 DP-2 eDP-1
workspace 3 output HDMI-A-2 HDMI-A-1 DP-1 DP-2 eDP-1
workspace 4 output eDP-1
# Home workspaces per app. Zoom runs under XWayland, so it matches on
# `class`, not `app_id`.
assign [app_id="^[Ss]lack$"] workspace number 1
assign [app_id="^kitty$"] workspace number 2
assign [app_id="^librewolf$"] workspace number 3
assign [class="^[Zz]oom$"] workspace number 4
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Tab workspace back_and_forth

### Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

### Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### Resize
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Popups ($mod+o prefix, tmux-style; Quickshell bar shows the mode and its keys)
mode "popup" {
    bindsym m exec qs-shell -q popups open media, mode "default"
    bindsym a exec qs-shell -q popups open audio, mode "default"
    bindsym n exec qs-shell -q popups open network, mode "default"
    bindsym b exec qs-shell -q popups open battery, mode "default"
    bindsym c exec qs-shell -q popups open clock, mode "default"
    bindsym w exec qs-shell -q popups open weather, mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+o mode "popup"

### Media keys (wpctl; -l 1.0 caps at 100%)
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec qs-shell -q media toggle
bindsym --locked XF86AudioNext exec qs-shell -q media next
bindsym --locked XF86AudioPrev exec qs-shell -q media previous
# No media keys on this keyboard → $mod+p family (Quickshell popup: $mod+Shift+p, vim keys inside)
bindsym --locked $mod+p exec qs-shell -q media toggle
bindsym --locked $mod+bracketright exec qs-shell -q media next
bindsym --locked $mod+bracketleft exec qs-shell -q media previous
bindsym $mod+Shift+p exec qs-shell -q popups toggle media
bindsym --locked XF86MonBrightnessUp exec qs-brightness up
bindsym --locked XF86MonBrightnessDown exec qs-brightness down

### Screenshot
bindsym Print exec qs-capture region
bindsym Shift+Print exec qs-capture screen
bindsym $mod+Shift+s exec qs-capture window
bindsym $mod+Print exec qs-capture region-clip
bindsym $mod+Ctrl+p exec qs-capture color

### Behaviour
smart_borders on
mouse_warping container

### Window rules
# qs-float: $mod+Shift+Return; qs-task: launcher-spawned terminal tasks (install, remove, update)
# `border pixel`: kitty negotiates CSD, which sway honours for floating windows (no border)
# No `resize set`: kitty picks a whole-cell size itself (kitty.conf initial_window_width/height)
for_window [app_id="^qs-(float|task)$"] floating enable, border pixel 1
# qs-screensaver: cmatrix in kitty, one per output (bin/qs-screensaver). Floating
# first: a new window is tiled next to the focused one before for_window runs, and
# fullscreen keeps that split, so the window underneath sat at half width until
# the screensaver closed and was seen snapping back
for_window [app_id="^qs-screensaver$"] floating enable, fullscreen enable
# LibreWolf picture-in-picture follows the workspace; portal dialogs (file chooser) are
# a separate process without a parent, so sway would tile them
for_window [app_id="^librewolf$" title="^Picture-in-Picture$"] floating enable, sticky enable
for_window [app_id="^xdg-desktop-portal-gtk$"] floating enable

