### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term ghostty
set $menu qs-shell launcher toggle

### Input
input type:keyboard {
    xkb_layout us,ua,ru
    # caps:super - Caps Lock is a second $mod for one-handed workspace keys
    xkb_options grp:alt_shift_toggle,caps:super
    repeat_delay 200
    repeat_rate 35
}

### Output
# No `output * bg` - swaybg not installed; Quickshell paints the wallpaper.
# Laptop panel is primary (workspace 1, tray); externals sit to its right.
output eDP-1 mode 1366x768@60Hz scale 1 position 0 0
output HDMI-A-2 mode 2560x1440@60Hz scale 1 position 1366 0

### Autostart
# qs-session: import env into systemd --user, start quickshell, wait for IPC, re-apply toggles
exec qs-session start

# Idle + lock ladder (swaylock/swayidle stay outside Quickshell on purpose).
exec swayidle -w \
    timeout 900 'pgrep -x swaylock || swaylock -f' \
    timeout 905 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    timeout 1800 'systemctl suspend-then-hibernate' \
    before-sleep 'pgrep -x swaylock || swaylock -f' \
    after-resume 'qs-shell -q shell resume'

### Basics
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Ctrl+q exec qs-quit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym $mod+Shift+r exec qs-session restart
bindsym $mod+Escape exec swaylock -f
bindsym $mod+Shift+n exec qs-toggle dnd
bindsym $mod+Shift+d exec qs-shell -q notifications dismissLatest
bindsym $mod+Shift+a exec qs-shell -q notifications actionLatest
bindsym $mod+n exec qs-shell launcher open notifications
bindsym $mod+c exec qs-shell launcher open clipboard
bindsym $mod+Shift+t exec qs-toggle nightlight
bindsym $mod+Shift+w exec qs-wallpaper random
bindsym $mod+Shift+Return exec $term --class=qs-float
floating_modifier $mod normal

